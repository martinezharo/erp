# Supabase Auth compatibility bridge (public browser values)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Convex application backend
CONVEX_URL=https://your-deployment.convex.cloud
# Optional: the Astro app prefers this over CONVEX_URL, which lets `convex dev`
# keep its local URL without making the app depend on a local Convex process.
CONVEX_PRODUCTION_URL=https://your-production-deployment.convex.cloud
# Server-only. Also set it with `pnpm exec convex env set CONVEX_BRIDGE_SECRET`.
CONVEX_BRIDGE_SECRET=generate-a-long-random-value
