{
    "name": "erp",
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "test": "vitest run",
        "test:convex": "vitest run --config vitest.convex.config.ts",
        "test:watch": "vitest",
        "api:key": "node scripts/create-api-key.mjs",
        "migrate:supabase": "node scripts/migrate-supabase-to-convex.mjs",
        "db:policies:check": "node scripts/check-rls-drift.mjs",
        "test:rls": "vitest run --config vitest.rls.config.ts",
        "prepare": "simple-git-hooks"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/cloudflare": "^12.6.13",
        "@astrojs/node": "^9.5.5",
        "@supabase/supabase-js": "^2.112.2",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^5.18.2",
        "chart.js": "^4.5.1",
        "convex": "^1.43.0",
        "nanostores": "^1.4.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@edge-runtime/vm": "^5.0.0",
        "@types/pg": "^8.20.4",
        "convex-test": "^0.0.55",
        "pg": "^8.22.0",
        "simple-git-hooks": "^2.13.1",
        "vite": "6.4.3",
        "vitest": "^4.1.10"
    },
    "simple-git-hooks": {
        "pre-push": "pnpm run check && pnpm run test"
    }
}
